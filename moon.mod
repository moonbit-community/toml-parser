name = "bobzhang/toml"

version = "0.4.2"

import {
  "bobzhang/lexer@0.2.0",
  "moonbitlang/quickcheck@0.14.0",
  "moonbitlang/x@0.4.41",
}

readme = "README.md"

repository = "https://github.com/moonbit-community/toml-parser"

license = "Apache-2.0"

keywords = [ "toml", "parser", "config" ]

description = "A TOML parser implementation in MoonBit"

warnings = "+a-unused_optional_argument-unused_default_value-missing_invariant-missing_reasoning"
